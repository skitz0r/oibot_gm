# Warcraft Logs v2 client (https://www.warcraftlogs.com/api/clients)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Claude API key (console.anthropic.com) — optional; without it the deterministic fallback runs
ANTHROPIC_API_KEY=

# Discord bot (https://discord.com/developers/applications) — for `oibot discord`
DISCORD_TOKEN=
# Server where slash commands are registered instantly (guild-scoped sync)
DISCORD_TEST_GUILD_ID=

# Optional per-workload model overrides
# OIBOT_MODEL_LOOT_RECOMMEND=claude-sonnet-5
# OIBOT_MODEL_ROSTER_EXPLAIN=claude-sonnet-5

# Blizzard Game Data API (https://develop.battle.net/access/clients) — item verification/onboarding
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Web dashboard (served inside the bot on localhost; a Cloudflare Tunnel publishes it)
OIBOT_WEB_BIND=127.0.0.1:8788
OIBOT_WEB_URL=https://gm.example.com
OIBOT_WEB_SECRET=…            # cookie signing; any long random string
# OIBOT_WEB_DEV_USER=…        # a Discord id: skip OAuth from localhost while developing
# Discord OAuth2 for the dashboard login (same application as the bot; add <OIBOT_WEB_URL>/auth/callback as a redirect)
DISCORD_CLIENT_ID=…
DISCORD_CLIENT_SECRET=…
